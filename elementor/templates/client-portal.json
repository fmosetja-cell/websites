              "elType": "widget",
              "settings": {
                "editor": "<p style=\"max-width:820px;\">The portal below is a visual concept for a future secure client portal. It is not a working system, requires no login, and every name, matter and figure shown is placeholder data — no real client information has been used.</p>"
              },
              "elements": [],
              "widgetType": "text-editor"
