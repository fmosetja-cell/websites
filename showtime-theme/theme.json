{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalettes": false,
      "defaultGradients": false,
      "gradients": [],
      "palette": [
        { "slug": "canvas", "name": "Canvas (black)", "color": "#000000" },
        { "slug": "surface-soft", "name": "Surface soft", "color": "#0d0d0d" },
        { "slug": "surface-card", "name": "Surface card", "color": "#141414" },
        { "slug": "surface-elevated", "name": "Surface elevated", "color": "#1f1f1f" },
        { "slug": "hairline", "name": "Hairline", "color": "#262626" },
        { "slug": "hairline-strong", "name": "Hairline strong", "color": "#3a3a3a" },
        { "slug": "on-dark", "name": "Heading / on dark", "color": "#ffffff" },
        { "slug": "body", "name": "Body text", "color": "#cccccc" },
        { "slug": "body-strong", "name": "Body strong", "color": "#e6e6e6" },
        { "slug": "muted", "name": "Muted", "color": "#999999" },
        { "slug": "muted-soft", "name": "Muted soft", "color": "#666666" },
        { "slug": "link", "name": "Link (ice blue)", "color": "#c3d9f3" },
        { "slug": "warning", "name": "Warning", "color": "#d4a017" },
        { "slug": "success", "name": "Success", "color": "#5fa657" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Saira Condensed)",
          "fontFamily": "\"Saira Condensed\", \"Arial Narrow\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Saira Condensed",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/saira-condensed-400.woff2"]
            }
          ]
        },
        {
          "slug": "text",
          "name": "Text (EB Garamond)",
          "fontFamily": "\"EB Garamond\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "EB Garamond",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/eb-garamond-400.woff2"]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono (JetBrains Mono)",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, monospace",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/jetbrains-mono-400.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "caption", "name": "Caption (mono)", "size": "11px" },
        { "slug": "nav", "name": "Nav (mono)", "size": "12px" },
        { "slug": "body-sm", "name": "Body S", "size": "14px" },
        { "slug": "body-md", "name": "Body M", "size": "16px" },
        { "slug": "title-md", "name": "Title M", "size": "20px" },
        { "slug": "display-sm", "name": "Display S", "size": "24px" },
        { "slug": "display-md", "name": "Display M", "size": "32px" },
        { "slug": "display-lg", "name": "Display L", "size": "48px" },
        { "slug": "display-xl", "name": "Display XL", "size": "64px" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "vh", "%"],
      "spacingSizes": [
        { "slug": "xs", "name": "XS — 8", "size": "8px" },
        { "slug": "sm", "name": "SM — 16", "size": "16px" },
        { "slug": "md", "name": "MD — 24", "size": "24px" },
        { "slug": "lg", "name": "LG — 40", "size": "40px" },
        { "slug": "xl", "name": "XL — 64", "size": "64px" },
        { "slug": "xxl", "name": "XXL — 96", "size": "96px" },
        { "slug": "band", "name": "Band — 120", "size": "120px" }
      ]
    },
    "border": {
      "radius": false,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "0px"
    },
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--body)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--text)",
      "fontSize": "var(--wp--preset--font-size--body-md)",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--link)" },
        "typography": { "textDecoration": "none" }
      },
      "heading": {
        "color": { "text": "var(--wp--preset--color--on-dark)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "textTransform": "uppercase"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display-xl)", "lineHeight": "1.1", "letterSpacing": "4px" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--display-lg)", "lineHeight": "1.15", "letterSpacing": "3px" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--display-md)", "lineHeight": "1.2", "letterSpacing": "2px" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--display-sm)", "lineHeight": "1.3", "letterSpacing": "1.5px" } },
      "button": {
        "color": { "background": "transparent", "text": "var(--wp--preset--color--on-dark)" },
        "border": { "color": "var(--wp--preset--color--on-dark)", "style": "solid", "width": "1px", "radius": "9999px" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "14px",
          "fontWeight": "400",
          "letterSpacing": "2.5px",
          "textTransform": "uppercase"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-services", "title": "Services", "postTypes": ["page"] },
    { "name": "page-about", "title": "About", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
